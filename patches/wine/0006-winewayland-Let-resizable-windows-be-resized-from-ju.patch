 dlls/winewayland.drv/wayland_pointer.c | 146 ++++++++++++++++++--
 dlls/winewayland.drv/wayland_surface.c | 179 +++++++++++++++++++++++++
 dlls/winewayland.drv/waylanddrv.h      |  24 ++++
 3 files changed, 340 insertions(+), 9 deletions(-)

