 static void pointer_handle_motion_internal(wl_fixed_t sx, wl_fixed_t sy)
 {
     INPUT input = {0};
@@ -165,6 +226,53 @@ static void pointer_handle_motion_internal(wl_fixed_t sx, wl_fixed_t sy)
     NtUserSendHardwareInput(hwnd, SEND_HWMSG_RAWINPUT, &input, 0);
 }
 
+static void wayland_set_cursor(HWND hwnd, HCURSOR hcursor, BOOL use_hcursor);
+
+/* Handles the pointer at a point of the surface it is on. Over the window, the
+ * window gets the input. Over the window's resize border, the window doesn't
+ * see the pointer, which shows a resize cursor instead. */
+static void pointer_handle_position(wl_fixed_t sx, wl_fixed_t sy, BOOL entered)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    double x = wl_fixed_to_double(sx), y = wl_fixed_to_double(sy);
+    struct wl_surface *wl_surface;
+    BOOL changed = entered;
+    uint32_t edge;
+    HWND hwnd;
+
+    pthread_mutex_lock(&pointer->mutex);
+    wl_surface = pointer->entered_surface;
+    hwnd = pointer->entered_hwnd;
+    pthread_mutex_unlock(&pointer->mutex);
+
+    if (!hwnd) return;
+
+    edge = wayland_surface_get_resize_edge(hwnd, wl_surface, &x, &y);
+
+    pthread_mutex_lock(&pointer->mutex);
+    if (pointer->entered_surface != wl_surface)
+    {
+        pthread_mutex_unlock(&pointer->mutex);
+        return;
+    }
+    /* Keep the input going to the window until it has seen the buttons it
+     * saw pressed released. */
+    if (pointer->buttons) edge = pointer->resize_edge;
+    if (edge != pointer->resize_edge) changed = TRUE;
+    pointer->resize_edge = edge;
+    pointer->focused_hwnd = edge ? NULL : hwnd;
+    if (edge && changed) wayland_pointer_set_resize_cursor(edge);
+    pthread_mutex_unlock(&pointer->mutex);
+
+    if (edge) return;
+
+    /* The cursor is undefined at every enter, so we set it again with
+     * the latest information we have. */
+    if (changed) wayland_set_cursor(hwnd, NULL, FALSE);
+
+    pointer_handle_motion_internal(wl_fixed_from_double(x), wl_fixed_from_double(y));
+}
+
 static void pointer_handle_motion(void *data, struct wl_pointer *wl_pointer,
                                   uint32_t time, wl_fixed_t sx, wl_fixed_t sy)
 {
@@ -173,11 +281,9 @@ static void pointer_handle_motion(void *data, struct wl_pointer *wl_pointer,
     /* Ignore absolute motion events if in relative mode. */
     if (pointer->relative_mode) return;
 
-    pointer_handle_motion_internal(sx, sy);
+    pointer_handle_position(sx, sy, FALSE);
 }
 
-static void wayland_set_cursor(HWND hwnd, HCURSOR hcursor, BOOL use_hcursor);
-
