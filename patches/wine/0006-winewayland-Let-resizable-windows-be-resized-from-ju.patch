@@ -900,6 +1035,8 @@ BOOL wayland_surface_reconfigure(struct wayland_surface *surface)
     case WAYLAND_SURFACE_ROLE_TOPLEVEL:
         if (!surface->xdg_surface) break; /* surface role has been cleared */
         if (!wayland_surface_reconfigure_xdg(surface, rect)) return FALSE;
+        wayland_surface_reconfigure_resize_border(surface, rect.right - rect.left,
+                                                  rect.bottom - rect.top);
         break;
     case WAYLAND_SURFACE_ROLE_SUBSURFACE:
         if (!surface->wl_subsurface) break; /* surface role has been cleared */
@@ -912,6 +1049,48 @@ BOOL wayland_surface_reconfigure(struct wayland_surface *surface)
     return TRUE;
 }
 
+/**********************************************************************
+ *          wayland_surface_get_resize_edge
+ *
+ * Maps a point on a window's surface or on its resize border to the window
+ * surface's coordinates, and returns the edges a press there resizes: none
+ * over the window. A compositor can keep the pointer on either surface while
+ * it is over the other, during implicit grabs for example, so where the point
+ * is counts, not which surface it is on.
+ */
+uint32_t wayland_surface_get_resize_edge(HWND hwnd, struct wl_surface *wl_surface,
+                                         double *x, double *y)
+{
+    struct wayland_resize_border *border;
+    struct wayland_win_data *data;
+    uint32_t edge = XDG_TOPLEVEL_RESIZE_EDGE_NONE;
+    int size = RESIZE_BORDER_SIZE, corner = RESIZE_CORNER_SIZE;
+
+    if (!(data = wayland_win_data_get(hwnd))) return edge;
+
+    if (data->wayland_surface && (border = data->wayland_surface->resize_border))
+    {
+        if (wl_surface == border->wl_surface)
+        {
+            *x -= size;
+            *y -= size;
+        }
+
+        /* On the border: outside the window, but not beyond the border. */
+        if ((*x < 0 || *y < 0 || *x >= border->width || *y >= border->height) &&
+            *x >= -size && *y >= -size && *x < border->width + size && *y < border->height + size)
+        {
+            if (*y < corner) edge |= XDG_TOPLEVEL_RESIZE_EDGE_TOP;
+            else if (*y >= border->height - corner) edge |= XDG_TOPLEVEL_RESIZE_EDGE_BOTTOM;
+            if (*x < corner) edge |= XDG_TOPLEVEL_RESIZE_EDGE_LEFT;
+            else if (*x >= border->width - corner) edge |= XDG_TOPLEVEL_RESIZE_EDGE_RIGHT;
+        }
+    }
+
+    wayland_win_data_release(data);
+    return edge;
+}
+
