@@ -122,6 +122,67 @@ static HWND wayland_pointer_get_focused_hwnd(void)
     return hwnd;
 }
 
+static enum wp_cursor_shape_device_v1_shape resize_edge_to_cursor_shape(uint32_t edge)
+{
+    switch (edge)
+    {
+    case XDG_TOPLEVEL_RESIZE_EDGE_TOP:
+    case XDG_TOPLEVEL_RESIZE_EDGE_BOTTOM:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NS_RESIZE;
+    case XDG_TOPLEVEL_RESIZE_EDGE_LEFT:
+    case XDG_TOPLEVEL_RESIZE_EDGE_RIGHT:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_EW_RESIZE;
+    case XDG_TOPLEVEL_RESIZE_EDGE_TOP_LEFT:
+    case XDG_TOPLEVEL_RESIZE_EDGE_BOTTOM_RIGHT:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NWSE_RESIZE;
+    case XDG_TOPLEVEL_RESIZE_EDGE_TOP_RIGHT:
+    case XDG_TOPLEVEL_RESIZE_EDGE_BOTTOM_LEFT:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NESW_RESIZE;
+    }
+    return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT;
+}
+
+/* Called with the pointer mutex held. */
+static void wayland_pointer_set_resize_cursor(uint32_t edge)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+
+    if (!pointer->wp_cursor_shape_device_v1)
+    {
+        pointer->wp_cursor_shape_device_v1 =
+            wp_cursor_shape_manager_v1_get_pointer(
+                process_wayland.wp_cursor_shape_manager_v1, pointer->wl_pointer);
+        if (!pointer->wp_cursor_shape_device_v1) return;
+    }
+
+    wp_cursor_shape_device_v1_set_shape(pointer->wp_cursor_shape_device_v1,
+                                        pointer->enter_serial,
+                                        resize_edge_to_cursor_shape(edge));
+    wl_display_flush(process_wayland.wl_display);
+}
+
+static void wayland_pointer_start_resize(HWND hwnd, uint32_t serial, uint32_t edge)
+{
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+
+    TRACE("hwnd=%p edge=%u\n", hwnd, edge);
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+
+    pthread_mutex_lock(&process_wayland.seat.mutex);
+    if (process_wayland.seat.wl_seat && (surface = data->wayland_surface) &&
+        wayland_surface_is_toplevel(surface))
+    {
+        xdg_toplevel_resize(surface->xdg_toplevel, process_wayland.seat.wl_seat,
+                            serial, edge);
+        wl_display_flush(process_wayland.wl_display);
+    }
+    pthread_mutex_unlock(&process_wayland.seat.mutex);
+
+    wayland_win_data_release(data);
+}
