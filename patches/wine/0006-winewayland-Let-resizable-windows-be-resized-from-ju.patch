+/* How far past its edges a resizable window can be resized from, and how far
+ * along its edges from a corner it resizes from the corner, in surface
+ * coordinates. */
+#define RESIZE_BORDER_SIZE 8
+#define RESIZE_CORNER_SIZE 16
+
+/**********************************************************************
+ *          wayland_resize_border_destroy
+ */
+static void wayland_resize_border_destroy(struct wayland_resize_border *border)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+
+    pthread_mutex_lock(&pointer->mutex);
+    if (border->wl_surface && pointer->entered_surface == border->wl_surface)
+    {
+        pointer->focused_hwnd = NULL;
+        pointer->entered_surface = NULL;
+        pointer->entered_hwnd = NULL;
+        pointer->resize_edge = 0;
+    }
+    pthread_mutex_unlock(&pointer->mutex);
+
+    if (border->wp_viewport) wp_viewport_destroy(border->wp_viewport);
+    if (border->wl_subsurface) wl_subsurface_destroy(border->wl_subsurface);
+    if (border->wl_surface) wl_surface_destroy(border->wl_surface);
+    if (border->shm_buffer) wayland_shm_buffer_unref(border->shm_buffer);
+    free(border);
+}
+
+/**********************************************************************
+ *          wayland_resize_border_create
+ */
+static struct wayland_resize_border *wayland_resize_border_create(struct wayland_surface *surface)
+{
+    struct wayland_resize_border *border;
+
+    if (!(border = calloc(1, sizeof(*border)))) goto err;
+
+    border->wl_surface = wl_compositor_create_surface(process_wayland.wl_compositor);
+    if (!border->wl_surface) goto err;
+    /* Pointer events on the border are for the window. */
+    wl_surface_set_user_data(border->wl_surface, surface->hwnd);
+
+    border->wl_subsurface = wl_subcompositor_get_subsurface(process_wayland.wl_subcompositor,
+                                                            border->wl_surface,
+                                                            surface->wl_surface);
+    if (!border->wl_subsurface) goto err;
+    wl_subsurface_place_below(border->wl_subsurface, surface->wl_surface);
+
+    border->wp_viewport = wp_viewporter_get_viewport(process_wayland.wp_viewporter,
+                                                     border->wl_surface);
+    if (!border->wp_viewport) goto err;
+
+    /* A transparent pixel, scaled to the size of the border. */
+    border->shm_buffer = wayland_shm_buffer_create(1, 1, WL_SHM_FORMAT_ARGB8888);
+    if (!border->shm_buffer) goto err;
+    wl_surface_attach(border->wl_surface, border->shm_buffer->wl_buffer, 0, 0);
+
+    return border;
+
+err:
+    ERR("Failed to create the resize border of hwnd=%p\n", surface->hwnd);
+    if (border) wayland_resize_border_destroy(border);
+    return NULL;
+}
+
