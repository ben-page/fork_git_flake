 }
 
+/**********************************************************************
+ *          wayland_surface_reconfigure_resize_border
+ *
+ * Gives a resizable toplevel a border reaching past its edges, so that, as
+ * with server-side decorations, it can be resized from just outside them.
+ * The border is transparent and only takes pointer input, which starts
+ * compositor resizes (see wayland_pointer.c).
+ */
+static void wayland_surface_reconfigure_resize_border(struct wayland_surface *surface,
+                                                      int width, int height)
+{
+    struct wayland_resize_border *border = surface->resize_border;
+    struct wl_region *region;
+    int size = RESIZE_BORDER_SIZE;
+
+    /* Resize cursors need the cursor shape protocol. A maximized or
+     * fullscreen window's border would reach into other monitors. */
+    if (!surface->window.resizeable || !process_wayland.wp_cursor_shape_manager_v1 ||
+        ((surface->window.state | surface->current.state) &
+         (WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED | WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN)) ||
+        width <= 0 || height <= 0)
+    {
+        if (border)
+        {
+            wayland_resize_border_destroy(border);
+            surface->resize_border = NULL;
+        }
+        return;
+    }
+
+    if (!border && !(border = surface->resize_border = wayland_resize_border_create(surface)))
+        return;
+    if (border->width == width && border->height == height) return;
+
+    TRACE("hwnd=%p size=%dx%d\n", surface->hwnd, width, height);
+
+    wl_subsurface_set_position(border->wl_subsurface, -size, -size);
+    wp_viewport_set_destination(border->wp_viewport, width + 2 * size, height + 2 * size);
+
+    /* Only take input outside the window, in case the window lets input
+     * through somewhere. */
+    if ((region = wl_compositor_create_region(process_wayland.wl_compositor)))
+    {
+        wl_region_add(region, 0, 0, width + 2 * size, height + 2 * size);
+        wl_region_subtract(region, size, size, width, height);
+        wl_surface_set_input_region(border->wl_surface, region);
+        wl_region_destroy(region);
+    }
+
+    /* Applied with the window's next commit. */
+    wl_surface_commit(border->wl_surface);
+
+    border->width = width;
+    border->height = height;
+}
+
