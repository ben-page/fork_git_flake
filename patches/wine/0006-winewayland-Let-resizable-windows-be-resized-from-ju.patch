@@ -223,6 +327,10 @@ static void pointer_handle_leave(void *data, struct wl_pointer *wl_pointer,
     pthread_mutex_lock(&pointer->mutex);
     pointer->focused_hwnd = NULL;
     pointer->enter_serial = 0;
+    pointer->entered_surface = NULL;
+    pointer->entered_hwnd = NULL;
+    pointer->resize_edge = 0;
+    pointer->buttons = 0;
     pthread_mutex_unlock(&pointer->mutex);
 }
 
@@ -232,10 +340,25 @@ static void pointer_handle_button(void *data, struct wl_pointer *wl_pointer,
 {
     struct wayland_pointer *pointer = &process_wayland.pointer;
     INPUT input = {0};
+    uint32_t edge;
     HWND hwnd;
 
     InterlockedExchange(&process_wayland.input_serial, serial);
 
+    pthread_mutex_lock(&pointer->mutex);
+    hwnd = pointer->entered_hwnd;
+    edge = pointer->resize_edge;
+    pthread_mutex_unlock(&pointer->mutex);
+
+    /* On a resize border, a press starts a compositor resize, and the window
+     * doesn't see the buttons. */
+    if (edge)
+    {
+        if (button == BTN_LEFT && state == WL_POINTER_BUTTON_STATE_PRESSED)
+            wayland_pointer_start_resize(hwnd, serial, edge);
+        return;
+    }
+
     if (!(hwnd = wayland_pointer_get_focused_hwnd())) return;
 
     input.type = INPUT_MOUSE;
@@ -263,6 +386,11 @@ static void pointer_handle_button(void *data, struct wl_pointer *wl_pointer,
     pthread_mutex_lock(&pointer->mutex);
     pointer->button_serial = state == WL_POINTER_BUTTON_STATE_PRESSED ?
                              serial : 0;
+    if (button >= BTN_MOUSE && button < BTN_MOUSE + 32)
+    {
+        if (state == WL_POINTER_BUTTON_STATE_PRESSED) pointer->buttons |= 1u << (button - BTN_MOUSE);
+        else pointer->buttons &= ~(1u << (button - BTN_MOUSE));
+    }
     pthread_mutex_unlock(&pointer->mutex);
 
     TRACE("hwnd=%p button=%#x state=%u\n", hwnd, button, state);
