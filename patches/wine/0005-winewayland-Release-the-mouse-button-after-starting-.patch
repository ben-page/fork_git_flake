From df1cc471b5a13cb6bbcc4717115c6d23fa8960cc Mon Sep 17 00:00:00 2001
From: Ben Page <744035+ben-page@users.noreply.github.com>
Date: Thu, 29 Oct 2026 17:03:44 -0500
Subject: [PATCH 5/6] winewayland: Release the mouse button after starting a
 move or resize.

xdg_toplevel_move and xdg_toplevel_resize hand the pointer to the
compositor, which then gets the button release that ends the operation.
The window never saw the button go up and kept treating every pointer
motion as a drag until the next click: WPF applications, for example,
started an OLE drag and showed the no-drop cursor after a window move.

Send the release once the compositor has the pointer, as winex11 does
when its window manager move or resize ends.
---
 dlls/winewayland.drv/wayland_pointer.c | 23 +++++++++++++++++++++++
 dlls/winewayland.drv/waylanddrv.h      |  1 +
 dlls/winewayland.drv/window.c          |  6 ++++++
 3 files changed, 30 insertions(+)

diff --git a/dlls/winewayland.drv/wayland_pointer.c b/dlls/winewayland.drv/wayland_pointer.c
index 0c190a9..7ffbf53 100644
--- a/dlls/winewayland.drv/wayland_pointer.c
+++ b/dlls/winewayland.drv/wayland_pointer.c
@@ -968,6 +968,29 @@ static void wayland_pointer_update_constraint(struct wl_surface *wl_surface,
     }
 }
 
+/**********************************************************************
+ *          wayland_pointer_release_button
+ *
+ * Releases the button held down in a window once the compositor has taken
+ * over the pointer for an interactive move or resize. The compositor gets the
+ * actual release, so the window would otherwise keep seeing the button
+ * pressed, as if the user were still dragging, until the next click.
+ */
+void wayland_pointer_release_button(HWND hwnd)
+{
+    INPUT input = {0};
+
+    input.type = INPUT_MOUSE;
+    if (NtUserGetKeyState(VK_LBUTTON) & 0x8000) input.mi.dwFlags = MOUSEEVENTF_LEFTUP;
+    else if (NtUserGetKeyState(VK_MBUTTON) & 0x8000) input.mi.dwFlags = MOUSEEVENTF_MIDDLEUP;
+    else if (NtUserGetKeyState(VK_RBUTTON) & 0x8000) input.mi.dwFlags = MOUSEEVENTF_RIGHTUP;
+    else return;
+
+    TRACE("hwnd=%p flags=%#x\n", hwnd, (int)input.mi.dwFlags);
+
+    NtUserSendHardwareInput(hwnd, SEND_HWMSG_RAWINPUT, &input, 0);
+}
+
 void wayland_pointer_clear_constraint(void)
 {
     wayland_pointer_update_constraint(NULL, NULL, FALSE);
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index 1cb525b..f2bdd70 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -420,6 +420,7 @@ void activate_keyboard_hkl(HWND hwnd, BOOL ime);
 void wayland_pointer_init(struct wl_pointer *wl_pointer);
 void wayland_pointer_deinit(void);
 void wayland_pointer_clear_constraint(void);
+void wayland_pointer_release_button(HWND hwnd);
 
 /**********************************************************************
  *          Wayland text input
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index 270fdfb..9746342 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -751,6 +751,7 @@ LRESULT WAYLAND_SysCommand(HWND hwnd, WPARAM wparam, LPARAM lparam, const POINT
     struct wl_seat *wl_seat;
     struct wayland_surface *surface;
     struct wayland_win_data *data;
+    BOOL started = FALSE;
 
     TRACE("cmd=%lx hwnd=%p, %lx, %lx\n",
           (long)command, hwnd, (long)wparam, lparam);
@@ -780,6 +781,7 @@ LRESULT WAYLAND_SysCommand(HWND hwnd, WPARAM wparam, LPARAM lparam, const POINT
                     xdg_toplevel_resize(surface->xdg_toplevel, wl_seat, button_serial,
                                         hittest_to_resize_edge(wparam & 0x0f));
                 }
+                started = TRUE;
             }
             pthread_mutex_unlock(&process_wayland.seat.mutex);
             wayland_win_data_release(data);
@@ -788,6 +790,10 @@ LRESULT WAYLAND_SysCommand(HWND hwnd, WPARAM wparam, LPARAM lparam, const POINT
     }
 
     wl_display_flush(process_wayland.wl_display);
+
+    /* The compositor gets the button release that ends the move or resize. */
+    if (started) wayland_pointer_release_button(hwnd);
+
     return ret;
 }
 
